erDiagram
    EMPLOYEE {
        int id PK
        string first_name
        string last_name
        string email
        string phone
    }
    STORE {
        int id PK
        string name
        string address
    }
    ROLE {
        int id PK
        string name
    }
    SHIFT {
        int id PK
        datetime start_time
        datetime end_time
    }
    SHIFT_ASSIGNMENT {
        int id PK
        datetime assigned_at
        enum status
    }
    SWAP_REQUEST {
        int id PK
        datetime created_at
        string reason
        enum status
        datetime decided_at "optional"
    }
    UNAVAILABILITY {
        int id PK
        datetime start_time
        datetime end_time
    }

    EMPLOYEE }o..o{ STORE : works_at
    EMPLOYEE }o..o{ ROLE : has_role
